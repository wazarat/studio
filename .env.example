# Dune Analytics API key — powers the Robinhood Chain "Transactions" chart in
# the landing page's Protocol analytics section. Optional: without it that one
# chart says "Chart data unavailable" and the rest of the section uses live
# DefiLlama data or the committed snapshot in content/analytics.ts.
# Server-side only (no NEXT_PUBLIC_ prefix); results are cached for 1 hour.
DUNE_API_KEY=

# Clerk — accounts for Studio, shared with canhav.dev. Until the canhav.com
# domain moves to Studio these are the Development instance keys (pk_test /
# sk_test) from the Clerk dashboard; the production instance is bound to
# canhav.com and cannot serve a vercel.app host. Without them /login shows a
# placeholder and /studio says sign-in is not configured.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where clerkMiddleware sends a signed-out visitor of a protected page, and
# where Clerk lands people after its own redirects. The provider repeats them.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/studio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/studio

# Ostium, the trading venue (Step 3). `true` builds and signs trades on
# Arbitrum Sepolia; `false` on Arbitrum One. Market data (pairs, prices,
# candles, fees, rollover) always comes from Arbitrum One (step 5b), so
# backtests and paper trading see the real venue. Server-side only.
OSTIUM_TESTNET=true
# Optional Arbitrum RPC for the selected chain. Empty uses the SDK's public
# default (fine for reads; the dev signer prefers a private endpoint).
OSTIUM_RPC_URL=
# Arbitrum One RPC for the Chainlink price check. Read in both modes, so the
# testnet page still shows the mainnet reference. Empty uses the public
# https://arb1.arbitrum.io/rpc.
ARBITRUM_ONE_RPC_URL=
# CanHav's builder address, attached to every open with a fee of 0 so trades
# are attributed without charging. Empty builds without a builder and the
# internal page says so.
CANHAV_BUILDER_ADDRESS=
# Testnet-only private key for the internal test trades. Lives in .env.local,
# never in a deploy. The signer refuses to load it when OSTIUM_TESTNET=false.
OSTIUM_DEV_PRIVATE_KEY=
# Comma-separated emails allowed to open /internal/*. Empty means nobody.
INTERNAL_ADMIN_EMAILS=
# How far the Ostium mid may sit from Chainlink before an open is refused on
# mainnet (basis points). Empty means 50 (0.5%).
CHAINLINK_TOLERANCE_BPS=

# Neon Postgres for strategies and backtests (step 4): the pooled connection
# string of a dev branch. Studio's tables live in the `studio` schema; run
# `npm run db:setup` once per branch to create them. Without it nothing
# saves and /studio says storage is not configured.
DATABASE_URL=

# Shared secret for the paper-trading tick (step 5). Vercel's cron sends it
# as `Authorization: Bearer <secret>`; an allowlisted admin session also
# passes. Empty disables the cron path; the manual button still works.
CRON_SECRET=

# Public base URL for the MCP connect commands (step 6): the deployment people
# connect to, no trailing slash. Empty uses the request origin.
NEXT_PUBLIC_APP_URL=
